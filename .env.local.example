# Kopiraj to datoteko v .env.local in vstavi svoje vrednosti iz Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Project Settings > API > "service_role" secret key.
# SAMO server-side (brez NEXT_PUBLIC_) - obide RLS, nikoli je ne izpostavi brskalniku.
# Uporablja se pri registraciji lastnika (/register), da lahko ustvarimo
# salon_owners vrstico tudi preden ima nov uporabnik aktivno sejo.
SUPABASE_SERVICE_ROLE_KEY=

# Za email obvestilo ob novi registraciji lastnika (resend.com - brezplačen nivo zadošča).
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=

# Kasneje za Twilio SMS obveščanje (server-side only, brez NEXT_PUBLIC_ predpone)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
